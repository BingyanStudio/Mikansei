<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pomodoro_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mikansei_neutral_surface"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/pomodoro_widget_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mikanseta 专注"
        android:textColor="@color/mikansei_text_secondary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pomodoro_widget_subject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingTop="6dp"
        android:text="开始一段专注"
        android:textColor="@color/mikansei_text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pomodoro_widget_timer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingTop="4dp"
        android:text="00:00"
        android:textColor="@color/mikansei_accent"
        android:textSize="44sp"
        android:textStyle="bold" />

    <Chronometer
        android:id="@+id/pomodoro_widget_chronometer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingTop="4dp"
        android:text="00:00"
        android:textColor="@color/mikansei_accent"
        android:textSize="44sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/pomodoro_widget_status"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="打开应用设置主题和计时方式"
        android:textColor="@color/mikansei_text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <Button
            android:id="@+id/pomodoro_widget_primary"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:minHeight="44dp"
            android:text="开始专注"
            android:textAllCaps="false"
            android:textSize="14sp" />

        <Button
            android:id="@+id/pomodoro_widget_finish"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:minHeight="44dp"
            android:text="结束"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
